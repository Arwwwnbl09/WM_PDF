# Backend reached by the Next.js server, including when browsers use a LAN IP.
PDF_API_URL=http://127.0.0.1:8000
# Leave NEXT_PUBLIC_API_URL unset for Vercel Services (repo Root Directory ./).
# For a standalone frontend, set the external backend HTTPS origin without
# /api/pdf before building. Allow the frontend via backend FRONTEND_ORIGINS.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
