# Backend reached by the Next.js server, including when browsers use a LAN IP.
PDF_API_URL=http://127.0.0.1:8000
# Required on Vercel: deploy the Python backend separately, set this in the
# Vercel project's Environment Variables, then redeploy. Use the HTTPS origin
# without /api/pdf. The backend must allow the frontend via FRONTEND_ORIGINS.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
